# Managed by Ansible role install_fail2ban.
# No [DEFAULT] section is used here, so existing SSH or service jails are not changed globally.

{% set _base_ignoreip = install_fail2ban_ignoreip | default(install_fail2ban_base_ignoreip) %}
{% if install_fail2ban_ip_whitelist_enabled | bool %}
{% set _allowed_ips = install_fail2ban_allowed_ips | default([]) %}
{% else %}
{% set _allowed_ips = [] %}
{% endif %}
{% set ignoreip = (_base_ignoreip + _allowed_ips) | unique | list | join(' ') %}

# -----------------------------------------------------------------------------
# High-confidence malicious path requests
# -----------------------------------------------------------------------------
[apache-malicious-paths]
enabled = {{ install_fail2ban_malicious_paths_enabled | ternary('true', 'false') }}
filter = apache-malicious-paths
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_access_log }}
maxretry = {{ install_fail2ban_malicious_paths_maxretry }}
findtime = {{ install_fail2ban_malicious_paths_findtime }}
bantime = {{ install_fail2ban_malicious_paths_bantime }}
bantime.increment = false
bantime.rndtime = 0

# -----------------------------------------------------------------------------
# Explicitly identified vulnerability scanners
# -----------------------------------------------------------------------------
[apache-scanner-useragents]
enabled = {{ install_fail2ban_scanner_useragents_enabled | ternary('true', 'false') }}
filter = apache-scanner-useragents
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_access_log }}
maxretry = {{ install_fail2ban_scanner_useragents_maxretry }}
findtime = {{ install_fail2ban_scanner_useragents_findtime }}
bantime = {{ install_fail2ban_scanner_useragents_bantime }}
bantime.increment = false
bantime.rndtime = 0

# -----------------------------------------------------------------------------
# Broad automated path scanning; deliberately temporary/progressive, not instant permanent.
# -----------------------------------------------------------------------------
[apache-scanburst]
enabled = {{ install_fail2ban_scanburst_enabled | ternary('true', 'false') }}
filter = apache-scanburst
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_access_log }}
maxretry = {{ install_fail2ban_scanburst_maxretry }}
findtime = {{ install_fail2ban_scanburst_findtime }}
bantime = {{ install_fail2ban_scanburst_bantime }}
bantime.increment = true
bantime.multipliers = {{ install_fail2ban_scanburst_multipliers }}
bantime.maxtime = {{ install_fail2ban_scanburst_maxtime }}
bantime.rndtime = {{ install_fail2ban_scanburst_rndtime }}
bantime.overalljails = {{ install_fail2ban_scanburst_overalljails | ternary('true', 'false') }}

