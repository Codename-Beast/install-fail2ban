# Verwaltet durch Ansible-Rolle install_fail2ban.
#
# Wichtig:
# - Kein globaler [DEFAULT]-Abschnitt: diese Datei soll fremde SSH-/Service-Jails
#   nicht nebenbei verändern.
# - ignoreip wird zentral aus Basiswerten, expliziter Whitelist und optional
#   importierten nftables-Sets gebaut.

{% set ignoreip = install_fail2ban_effective_ignoreip | default(install_fail2ban_ignoreip | default(install_fail2ban_base_ignoreip)) | unique | list | join(' ') %}

# -----------------------------------------------------------------------------
# SSH-Bruteforce-Schutz.
# Konservativ halten: ein SSH-Lockout ist betrieblich deutlich schlimmer als ein
# temporär nicht gesperrter Fehlversuch.
# -----------------------------------------------------------------------------
[sshd]
enabled = {{ install_fail2ban_sshd_enabled | ternary('true', 'false') }}
filter = sshd
port = {{ install_fail2ban_sshd_port }}
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = systemd
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
maxretry = {{ install_fail2ban_sshd_maxretry }}
findtime = {{ install_fail2ban_sshd_findtime }}
bantime = {{ install_fail2ban_sshd_bantime }}
bantime.increment = {{ install_fail2ban_sshd_bantime_increment | ternary('true', 'false') }}
bantime.multipliers = {{ install_fail2ban_sshd_bantime_multipliers }}
bantime.maxtime = {{ install_fail2ban_sshd_bantime_maxtime }}
bantime.rndtime = {{ install_fail2ban_sshd_bantime_rndtime }}

# -----------------------------------------------------------------------------
# Eindeutig bösartige Pfade: Fremdsysteme, Secrets, Webshells, bekannte Exploits.
# Ein Treffer reicht für einen permanenten Ban auf HTTP/HTTPS.
# -----------------------------------------------------------------------------
[apache-malicious-paths]
enabled = {{ install_fail2ban_malicious_paths_enabled | ternary('true', 'false') }}
filter = apache-malicious-paths
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_access_log }}
maxretry = {{ install_fail2ban_malicious_paths_maxretry }}
findtime = {{ install_fail2ban_malicious_paths_findtime }}
bantime = {{ install_fail2ban_malicious_paths_bantime }}
bantime.increment = false
bantime.rndtime = 0

# -----------------------------------------------------------------------------
# Explizit benannte Scanner im User-Agent.
# Die Liste kommt aus defaults/main.yml und kann pro Host erweitert werden.
# -----------------------------------------------------------------------------
[apache-scanner-useragents]
enabled = {{ install_fail2ban_scanner_useragents_enabled | ternary('true', 'false') }}
filter = apache-scanner-useragents
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_access_log }}
maxretry = {{ install_fail2ban_scanner_useragents_maxretry }}
findtime = {{ install_fail2ban_scanner_useragents_findtime }}
bantime = {{ install_fail2ban_scanner_useragents_bantime }}
bantime.increment = false
bantime.rndtime = 0

# -----------------------------------------------------------------------------
# Breite Pfadscans über viele 400/403/404/405/408/414 Antworten.
# Dieser Jail ist absichtlich nicht sofort permanent, weil NAT-/Campus-IP-Adressen
# viele legitime Benutzer repräsentieren können.
# -----------------------------------------------------------------------------
[apache-scanburst]
enabled = {{ install_fail2ban_scanburst_enabled | ternary('true', 'false') }}
filter = apache-scanburst
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_access_log }}
maxretry = {{ install_fail2ban_scanburst_maxretry }}
findtime = {{ install_fail2ban_scanburst_findtime }}
bantime = {{ install_fail2ban_scanburst_bantime }}
bantime.increment = true
bantime.multipliers = {{ install_fail2ban_scanburst_multipliers }}
bantime.maxtime = {{ install_fail2ban_scanburst_maxtime }}
bantime.rndtime = {{ install_fail2ban_scanburst_rndtime }}
bantime.overalljails = {{ install_fail2ban_scanburst_overalljails | ternary('true', 'false') }}

# -----------------------------------------------------------------------------
# Eingebauter Apache-Overflow-Filter.
# -----------------------------------------------------------------------------
[apache-overflows]
enabled = {{ install_fail2ban_overflows_enabled | ternary('true', 'false') }}
filter = apache-overflows
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_error_log }}
maxretry = {{ install_fail2ban_overflows_maxretry }}
findtime = {{ install_fail2ban_overflows_findtime }}
bantime = {{ install_fail2ban_overflows_bantime }}
bantime.increment = false
bantime.rndtime = 0

# -----------------------------------------------------------------------------
# Eingebauter Shellshock-Filter. Shellshock-Probes sind hochgradig eindeutig.
# -----------------------------------------------------------------------------
[apache-shellshock]
enabled = {{ install_fail2ban_shellshock_enabled | ternary('true', 'false') }}
filter = apache-shellshock
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_error_log }}
maxretry = {{ install_fail2ban_shellshock_maxretry }}
findtime = {{ install_fail2ban_shellshock_findtime }}
bantime = {{ install_fail2ban_shellshock_bantime }}
bantime.increment = false
bantime.rndtime = 0

# -----------------------------------------------------------------------------
# Optional: Apache Basic/Digest Auth. Das ist NICHT der Moodle-Formularlogin.
# Nur aktivieren, wenn Apache-Auth wirklich genutzt wird.
# -----------------------------------------------------------------------------
[apache-auth]
enabled = {{ install_fail2ban_apache_auth_enabled | ternary('true', 'false') }}
filter = apache-auth
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_error_log }}
maxretry = {{ install_fail2ban_apache_auth_maxretry }}
findtime = {{ install_fail2ban_apache_auth_findtime }}
bantime = {{ install_fail2ban_apache_auth_bantime }}

# -----------------------------------------------------------------------------
# Optional: eingebaute Apache-Bot-Hilfsfilter.
# Default bleibt false, weil sie je nach Logformat/Anwendung False Positives
# erzeugen oder sich mit den eigenen Filtern überschneiden können.
# -----------------------------------------------------------------------------
[apache-badbots]
enabled = {{ install_fail2ban_apache_badbots_enabled | ternary('true', 'false') }}
filter = apache-badbots
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_access_log }}
maxretry = {{ install_fail2ban_apache_badbots_maxretry }}
findtime = {{ install_fail2ban_apache_badbots_findtime }}
bantime = {{ install_fail2ban_apache_badbots_bantime }}

[apache-botsearch]
enabled = {{ install_fail2ban_apache_botsearch_enabled | ternary('true', 'false') }}
filter = apache-botsearch
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction }}
action = %(action_)s
logpath = {{ install_fail2ban_error_log }}
maxretry = {{ install_fail2ban_apache_botsearch_maxretry }}
findtime = {{ install_fail2ban_apache_botsearch_findtime }}
bantime = {{ install_fail2ban_apache_botsearch_bantime }}

# -----------------------------------------------------------------------------
# Wiederholungstäter: wer innerhalb des Fensters mehrfach von anderen Jails
# gebannt wurde, wird dauerhaft auf allen Ports gesperrt.
# -----------------------------------------------------------------------------
[recidive]
enabled = {{ install_fail2ban_recidive_enabled | ternary('true', 'false') }}
filter = recidive
logpath = /var/log/fail2ban.log
protocol = tcp,udp
ignoreip = {{ ignoreip }}
ignoreself = {{ install_fail2ban_ignoreself | ternary('true', 'false') }}
usedns = {{ install_fail2ban_usedns }}
backend = {{ install_fail2ban_backend }}
banaction = {{ install_fail2ban_banaction_allports }}
action = %(action_)s
maxretry = {{ install_fail2ban_recidive_maxretry }}
findtime = {{ install_fail2ban_recidive_findtime }}
bantime = {{ install_fail2ban_recidive_bantime }}
bantime.increment = false
bantime.rndtime = 0
