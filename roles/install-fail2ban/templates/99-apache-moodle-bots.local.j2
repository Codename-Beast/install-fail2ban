findtime = {{ fail2ban_apache_botsearch_findtime }}
bantime = {{ fail2ban_apache_botsearch_bantime }}

# Repeat offenders: sources banned multiple times by other jails within the window
# are blocked permanently on all ports.
[recidive]
enabled = {{ fail2ban_recidive_enabled | bool | ternary('true', 'false') }}
filter = recidive
logpath = /var/log/fail2ban.log
protocol = tcp,udp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction_allports }}
action = %(action_)s
maxretry = {{ fail2ban_recidive_maxretry }}
findtime = {{ fail2ban_recidive_findtime }}
bantime = {{ fail2ban_recidive_bantime }}
bantime.increment = false
bantime.rndtime = 0
