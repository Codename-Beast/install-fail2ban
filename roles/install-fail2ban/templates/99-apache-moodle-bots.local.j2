# Managed by Ansible role install-fail2ban.
#
# Notes:
# - No global [DEFAULT] section: this file must not change unrelated SSH/service jails.
# - ignoreip is built from base values, explicit allowlists, and optional imported nftables sets.

{% set ignoreip_list = (fail2ban_effective_ignoreip | default((fail2ban_base_ignoreip | default([])) + (fail2ban_ignoreip | default([])))) | map('string') | map('trim') | reject('equalto', '') | unique | list %}
{% set ignoreip = ignoreip_list | join(' ') %}
# Jail-local ignore lists are merged per jail, not globally: a CI runner,
# integration backend, or monitoring host may be safe for one signal but must
# still be visible to every unrelated jail.
{% set infra_admin_ignoreip = (ignoreip_list + (fail2ban_infra_admin_exposure_ignoreip | default([]) | map('string') | map('trim') | reject('equalto', '') | list)) | unique | list | join(' ') %}
{% set webservice_ignoreip = (ignoreip_list + (fail2ban_moodle_webservice_abuse_ignoreip | default([]) | map('string') | map('trim') | reject('equalto', '') | list)) | unique | list | join(' ') %}
{% set behat_ignoreip = (ignoreip_list + (fail2ban_moodle_behat_access_ignoreip | default([]) | map('string') | map('trim') | reject('equalto', '') | list)) | unique | list | join(' ') %}

# SSH brute-force protection.
# Keep this conservative: an SSH lockout is operationally worse than a temporary missed ban.
[sshd]
enabled = {{ fail2ban_sshd_enabled | bool | ternary('true', 'false') }}
filter = sshd
port = {{ fail2ban_sshd_port }}
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_sshd_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
maxretry = {{ fail2ban_sshd_maxretry }}
findtime = {{ fail2ban_sshd_findtime }}
bantime = {{ fail2ban_sshd_bantime }}
bantime.increment = {{ fail2ban_sshd_bantime_increment | bool | ternary('true', 'false') }}
bantime.multipliers = {{ fail2ban_sshd_bantime_multipliers }}
bantime.maxtime = {{ fail2ban_sshd_bantime_maxtime }}
bantime.rndtime = {{ fail2ban_sshd_bantime_rndtime }}

# malicious paths: foreign apps, secrets, web shells, known exploits.
# One match is enough for a permanent HTTP/HTTPS ban.
[apache-malicious-paths]
enabled = {{ fail2ban_malicious_paths_enabled | bool | ternary('true', 'false') }}
filter = apache-malicious-paths
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_malicious_paths_maxretry }}
findtime = {{ fail2ban_malicious_paths_findtime }}
bantime = {{ fail2ban_malicious_paths_bantime }}
bantime.increment = false
bantime.rndtime = 0

# Moodle Badbots: authentication/token endpoint abuse.
# Threshold-based: one failed login is not a ban, repeated automated POSTs are.
[moodle-badbots]
enabled = {{ fail2ban_moodle_badbots_enabled | bool | ternary('true', 'false') }}
filter = moodle-badbots
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_moodle_badbots_maxretry }}
findtime = {{ fail2ban_moodle_badbots_findtime }}
bantime = {{ fail2ban_moodle_badbots_bantime }}
bantime.increment = true
bantime.multipliers = {{ fail2ban_moodle_badbots_multipliers }}
bantime.maxtime = {{ fail2ban_moodle_badbots_maxtime }}
bantime.rndtime = {{ fail2ban_moodle_badbots_rndtime }}

# Moodle Webservice abuse: high-volume API execution after token acquisition.
# Threshold-based because mobile apps and integrations legitimately use it.
[moodle-webservice-abuse]
enabled = {{ fail2ban_moodle_webservice_abuse_enabled | bool | ternary('true', 'false') }}
filter = moodle-webservice-abuse
port = http,https
protocol = tcp
ignoreip = {{ webservice_ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_moodle_webservice_abuse_maxretry }}
findtime = {{ fail2ban_moodle_webservice_abuse_findtime }}
bantime = {{ fail2ban_moodle_webservice_abuse_bantime }}
bantime.increment = true
bantime.multipliers = {{ fail2ban_moodle_webservice_abuse_multipliers }}
bantime.maxtime = {{ fail2ban_moodle_webservice_abuse_maxtime }}
bantime.rndtime = {{ fail2ban_moodle_webservice_abuse_rndtime }}

# Moodle password reset abuse: repeated account-enumeration form submissions.
# Lower threshold than login abuse because normal users rarely repeat this often.
[moodle-password-reset-abuse]
enabled = {{ fail2ban_moodle_password_reset_abuse_enabled | bool | ternary('true', 'false') }}
filter = moodle-password-reset-abuse
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_moodle_password_reset_abuse_maxretry }}
findtime = {{ fail2ban_moodle_password_reset_abuse_findtime }}
bantime = {{ fail2ban_moodle_password_reset_abuse_bantime }}
bantime.increment = true
bantime.multipliers = {{ fail2ban_moodle_password_reset_abuse_multipliers }}
bantime.maxtime = {{ fail2ban_moodle_password_reset_abuse_maxtime }}
bantime.rndtime = {{ fail2ban_moodle_password_reset_abuse_rndtime }}

# Moodle Behat exposure: public 200 responses and probes for leftover Behat paths.
# First hit bans immediately; repeat offenders escalate beyond the initial short ban.
[moodle-behat-access]
enabled = {{ fail2ban_moodle_behat_access_enabled | bool | ternary('true', 'false') }}
filter = moodle-behat-access
port = http,https
protocol = tcp
ignoreip = {{ behat_ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_moodle_behat_access_maxretry }}
findtime = {{ fail2ban_moodle_behat_access_findtime }}
bantime = {{ fail2ban_moodle_behat_access_bantime }}
bantime.increment = {{ fail2ban_moodle_behat_access_bantime_increment | bool | ternary('true', 'false') }}
bantime.multipliers = {{ fail2ban_moodle_behat_access_multipliers }}
bantime.maxtime = {{ fail2ban_moodle_behat_access_maxtime }}
bantime.rndtime = {{ fail2ban_moodle_behat_access_rndtime }}

# Explicitly named scanners in the User-Agent.
# The list comes from defaults/main.yml and can be extended per host.
[apache-scanner-useragents]
enabled = {{ fail2ban_scanner_useragents_enabled | bool | ternary('true', 'false') }}
filter = apache-scanner-useragents
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_scanner_useragents_maxretry }}
findtime = {{ fail2ban_scanner_useragents_findtime }}
bantime = {{ fail2ban_scanner_useragents_bantime }}
bantime.increment = false
bantime.rndtime = 0


# Unusual User-Agents: missing, empty or oversized values.
# Immediate short nftables ban; recidive escalates repeat offenders to all ports.
[apache-unusual-useragents]
enabled = {{ fail2ban_unusual_useragents_enabled | bool | ternary('true', 'false') }}
filter = apache-unusual-useragents
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_unusual_useragents_maxretry }}
findtime = {{ fail2ban_unusual_useragents_findtime }}
bantime = {{ fail2ban_unusual_useragents_bantime }}
bantime.increment = false
bantime.rndtime = 0

# Wide path scans across many 400/403/404/405/408/414 responses.
# This jail is not immediately permanent because NAT/campus IPs may represent many valid users.
[apache-scanburst]
enabled = {{ fail2ban_scanburst_enabled | bool | ternary('true', 'false') }}
filter = apache-scanburst
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_scanburst_maxretry }}
findtime = {{ fail2ban_scanburst_findtime }}
bantime = {{ fail2ban_scanburst_bantime }}
bantime.increment = true
bantime.multipliers = {{ fail2ban_scanburst_multipliers }}
bantime.maxtime = {{ fail2ban_scanburst_maxtime }}
bantime.rndtime = {{ fail2ban_scanburst_rndtime }}
# Keep false unless you intentionally want repeated HTTP error bursts in other
# jails to extend this jail's escalation history as well.
bantime.overalljails = {{ fail2ban_scanburst_overalljails | bool | ternary('true', 'false') }}

# Low-and-slow scan detection across the same client-error signal as scanburst.
# Optional because long windows can hit NAT/campus IPs on noisy public systems.
[apache-slow-scan]
enabled = {{ fail2ban_slow_scan_enabled | bool | ternary('true', 'false') }}
# Reuse the scanburst filter deliberately: same 4xx signal, much longer window.
filter = apache-scanburst
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_slow_scan_maxretry }}
findtime = {{ fail2ban_slow_scan_findtime }}
bantime = {{ fail2ban_slow_scan_bantime }}
bantime.increment = true
bantime.multipliers = {{ fail2ban_slow_scan_multipliers }}
bantime.maxtime = {{ fail2ban_slow_scan_maxtime }}
bantime.rndtime = {{ fail2ban_slow_scan_rndtime }}
# Same semantics as scanburst; default false keeps this long-window escalation
# local to slow-scan instead of coupling it to every other jail.
bantime.overalljails = {{ fail2ban_slow_scan_overalljails | bool | ternary('true', 'false') }}

