filter = apache-infra-admin-exposure
port = http,https
protocol = tcp
ignoreip = {{ infra_admin_ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_infra_admin_exposure_maxretry }}
findtime = {{ fail2ban_infra_admin_exposure_findtime }}
bantime = {{ fail2ban_infra_admin_exposure_bantime }}
bantime.increment = false
bantime.rndtime = 0

# Optional fake Googlebot detection. Uses Fail2Ban's built-in rDNS ignorecommand.
# Default-off because this jail performs DNS lookups unlike the other web jails.
[apache-fakegooglebot]
enabled = {{ fail2ban_apache_fakegooglebot_enabled | bool | ternary('true', 'false') }}
filter = apache-fakegooglebot
port = http,https
protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_apache_fakegooglebot_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_apache_fakegooglebot_maxretry }}
findtime = {{ fail2ban_apache_fakegooglebot_findtime }}
bantime = {{ fail2ban_apache_fakegooglebot_bantime }}
bantime.increment = false
bantime.rndtime = 0
ignorecommand = %(fail2ban_confpath)s/filter.d/ignorecommands/apache-fakegooglebot <ip> {{ fail2ban_apache_fakegooglebot_ignorecommand_timeout }}

# Optional: built-in Apache bot helper filters.
# apache-badbots is enabled by current role default; apache-botsearch stays
# default-off. Test broad built-in bot filters against real logs before rollout.
[apache-badbots]
enabled = {{ fail2ban_apache_badbots_enabled | bool | ternary('true', 'false') }}
filter = apache-badbots
