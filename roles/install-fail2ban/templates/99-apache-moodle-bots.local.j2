protocol = tcp
ignoreip = {{ ignoreip }}
ignoreself = {{ fail2ban_ignoreself | bool | ternary('true', 'false') }}
usedns = {{ fail2ban_usedns }}
backend = {{ fail2ban_backend }}
banaction = {{ fail2ban_banaction }}
action = %(action_)s
logpath = {{ fail2ban_access_log }}
maxretry = {{ fail2ban_apache_badbots_maxretry }}
findtime = {{ fail2ban_apache_badbots_findtime }}
bantime = {{ fail2ban_apache_badbots_bantime }}

[apache-botsearch]
