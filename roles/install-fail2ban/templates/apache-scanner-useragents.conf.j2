[Definition]
# Managed by Ansible role install-fail2ban.
#
# This filter bans only explicitly named security/enumeration tools.
# Generic clients such as curl, wget, python-requests, or Go-http-client are
# not included because they may be used legitimately for monitoring, APIs,
# and administration.

{% set _scanner_agents = ((fail2ban_scanner_useragents | default([])) + (fail2ban_scanner_useragents_extra | default([]))) | map('string') | map('trim') | reject('equalto', '') | unique | list %}
{% set _scanner_ignore_agents = (fail2ban_scanner_useragents_ignore | default([])) | map('string') | map('trim') | reject('equalto', '') | unique | list %}
{% if _scanner_agents | length > 0 %}
failregex = ^(?:\S+:\d+\s+)?<HOST>.*"[^"]*"\s+\d{3}(?:\s+\S+)?\s+"[^"]*"\s+"[^"]*(?i:{{ _scanner_agents | map('regex_escape') | join('|') }})[^"]*"(?:\s+.*)?$
{% else %}
# No scanner User-Agent fragments are configured. Keep the filter valid but inert.
failregex = ^$
{% endif %}
{% if _scanner_ignore_agents | length > 0 %}
ignoreregex = ^(?:\S+:\d+\s+)?<HOST>.*"[^"]*"\s+\d{3}(?:\s+\S+)?\s+"[^"]*"\s+"[^"]*(?i:{{ _scanner_ignore_agents | map('regex_escape') | join('|') }})[^"]*"(?:\s+.*)?$
{% else %}
ignoreregex =
{% endif %}
